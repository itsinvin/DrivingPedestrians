  <asset><unit meter="1" name="meter"/><up_axis>Z_UP</up_axis></asset>
  <library_effects>
    <effect id="dp_skin-effect">
      <profile_COMMON>
        <newparam sid="dp_skin_surface"><surface type="2D"><init_from>dp_skin</init_from></surface></newparam>
        <newparam sid="dp_skin_sampler"><sampler2D><source>dp_skin_surface</source></sampler2D></newparam>
        <technique sid="common">
          <phong>
            <diffuse><texture texture="dp_skin_sampler" texcoord="UVMap"/></diffuse>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
    <effect id="dp_hair-effect">
      <profile_COMMON>
        <newparam sid="dp_hair_surface"><surface type="2D"><init_from>dp_hair</init_from></surface></newparam>
        <newparam sid="dp_hair_sampler"><sampler2D><source>dp_hair_surface</source></sampler2D></newparam>
        <technique sid="common">
          <phong>
            <diffuse><texture texture="dp_hair_sampler" texcoord="UVMap"/></diffuse>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
    <effect id="dp_shirt-effect">
      <profile_COMMON>
        <newparam sid="dp_shirt_surface"><surface type="2D"><init_from>dp_shirt</init_from></surface></newparam>
        <newparam sid="dp_shirt_sampler"><sampler2D><source>dp_shirt_surface</source></sampler2D></newparam>
        <technique sid="common">
          <phong>
            <diffuse><texture texture="dp_shirt_sampler" texcoord="UVMap"/></diffuse>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
    <effect id="dp_pants-effect">
      <profile_COMMON>
        <newparam sid="dp_pants_surface"><surface type="2D"><init_from>dp_pants</init_from></surface></newparam>
        <newparam sid="dp_pants_sampler"><sampler2D><source>dp_pants_surface</source></sampler2D></newparam>
        <technique sid="common">
          <phong>
            <diffuse><texture texture="dp_pants_sampler" texcoord="UVMap"/></diffuse>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
    <effect id="dp_shoes-effect">
      <profile_COMMON>
        <newparam sid="dp_shoes_surface"><surface type="2D"><init_from>dp_shoes</init_from></surface></newparam>
        <newparam sid="dp_shoes_sampler"><sampler2D><source>dp_shoes_surface</source></sampler2D></newparam>
        <technique sid="common">
          <phong>
            <diffuse><texture texture="dp_shoes_sampler" texcoord="UVMap"/></diffuse>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
